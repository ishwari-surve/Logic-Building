class Logic
{
    void checkPalindrome(int num)
    {
        // Write logic here
        int iOriginal = num;   
        int iReverse = 0;
        int iDigit = 0;

        while(num > 0)
        {
            iDigit   = num % 10;              // get last digit
            iReverse = iReverse * 10 + iDigit; // build reverse number
            num      = num / 10;              // remove last digit
        }

        if(iOriginal == iReverse)
        {
            System.out.println(iOriginal + " is Palindrome");
        }
        else
        {
            System.out.println(iOriginal + " is NOT Palindrome");
        }
    }
}

class Program
{
    public static void main(String args[])
    {
        Logic obj = new Logic();
        obj.checkPalindrome(121);
    }
} 
